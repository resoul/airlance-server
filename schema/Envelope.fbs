namespace Airlance.Wire;

enum MessageKind : ushort {
  None = 0,
  Ping = 1,
  Pong = 2,
  Error = 3,
  ProfileGet = 4,
  ProfileSet = 5,
  ProfileData = 6,
  Authenticate = 7,
  Authenticated = 8,
  UpdatesSubscribe = 9,
  UpdatesSubscribed = 10,
  MediaUploadRequest = 11,
  MediaUploadTicket = 12,
  MediaDownloadRequest = 13,
  MediaDownloadTicket = 14,
  Search = 15,
  SearchResults = 16,
  PublicProfileGet = 17,
  ChatOpenDirect = 18,
  ChatData = 19,
  MessageSend = 20,
  MessageData = 21,
  HistoryGet = 22,
  HistoryData = 23,
  ChatsGet = 24,
  ChatsData = 25,
  ProfilePhotoAdd = 26,
  ProfilePhotoRemove = 27,
  StoryPublish = 28,
  StoryData = 29,
  StoriesGet = 30,
  StoriesData = 31,
  StoryView = 32,
  StoryDelete = 33,
  StoriesChanged = 34,
  PrivacyGet = 35,
  PrivacySet = 36,
  PrivacyData = 37,
  BlocksGet = 38,
  BlocksData = 39,
  BlockSet = 40,
  ContactsGet = 41,
  ContactsData = 42,
  ContactAdd = 43,
  ContactAddPhone = 44,
  ContactRemove = 45,
  ContactsSync = 46,
  ContactsChanged = 47,
