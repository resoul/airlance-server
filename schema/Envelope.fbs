namespace Airlance.Wire;

enum MessageKind : ushort {
  None = 0,
  Ping = 1,
  Pong = 2,
  Error = 3,
  ProfileGet = 4,
  ProfileSet = 5,
  ProfileData = 6,
  Authenticate = 7,
  Authenticated = 8,
  UpdatesSubscribe = 9,
  UpdatesSubscribed = 10,
  MediaUploadRequest = 11,
  MediaUploadTicket = 12,
  MediaDownloadRequest = 13,
  MediaDownloadTicket = 14,
  Search = 15,
  SearchResults = 16,
  PublicProfileGet = 17,
}

table Envelope {
  seq: ulong;
  request_id: ulong;
  kind: ushort;
  body: [ubyte];
}

root_type Envelope;
file_identifier "ALNC";
