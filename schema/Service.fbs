  meta: string;
}

table StoryData {
  story_id: string;
  client_id: string;
  owner_subject: string;
  owner_first_name: string;
  owner_last_name: string;
  owner_photo_media_id: string;
  owner_video_media_id: string;
  media_id: string;
  cover_media_id: string;
  is_video: bool;
  meta: string;
  created_at_unix: long;
  expires_at_unix: long;
  seen: bool;
  view_count: int;
}

table StoriesGet {
}

table StoriesData {
