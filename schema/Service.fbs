  subject: string;
  first_name: string;
  last_name: string;
  username: string;
  photo_media_id: string;
  video_media_id: string;
}

table SearchResults {
  people: [SearchPerson];
}

table PublicProfileGet {
  subject: string;
}

table MessageAttachment {
  kind: int;
  media_id: string;
  thumb_media_id: string;
  name: string;
  size: long;
  width: int;
  height: int;
  duration_ms: int;
  waveform: [ubyte];
  title: string;
  performer: string;
  latitude: double;
  longitude: double;
  phone: string;
}

table MessageEntity {
  kind: int;
  offset: int;
  length: int;
  user_id: string;
}

table ReactionCount {
  emoji: string;
  count: int;
}

table PollOption {
  text: string;
  votes: int;
  voters: [PostCommenter];
}

table PollData {
  question: string;
  options: [PollOption];
  anonymous: bool;
  multiple: bool;
  is_quiz: bool;
  correct_option: int;
  explanation: string;
  close_at_unix_ms: long;
  is_closed: bool;
  total_voters: int;
  my_choices: [int];
}

table MessageData {
  chat_id: string;
  message_id: long;
  sender: string;
  client_id: string;
  text: string;
  sent_at_unix_ms: long;
  sender_first_name: string;
  sender_last_name: string;
  sender_photo_media_id: string;
  sender_video_media_id: string;
  agent_name: string;
  forward_name: string;
  attachments: [MessageAttachment];
  reply_to_id: long;
  entities: [MessageEntity];
  edited_at_unix_ms: long;
  thread_id: long;
  reactions: [ReactionCount];
  my_reaction: string;
  poll: PollData;
}

table ChatData {
  chat_id: string;
  peer_subject: string;
  peer_first_name: string;
  peer_last_name: string;
  peer_username: string;
  last_message: MessageData;
  peer_photo_media_id: string;
  peer_video_media_id: string;
  kind: int;
  title: string;
  about: string;
  link: string;
  invite_token: string;
  member_count: int;
  role: int;
  is_member: bool;
  is_pinned: bool;
  is_muted: bool;
  my_read_id: long;
  peer_read_id: long;
  unread: int;
  is_archived: bool;
  draft: string;
  draft_at_unix_ms: long;
  peer_delivered_id: long;
  member_rights: long;
  my_rights: long;
  rules: ChatRules;
}

table ChatOpenDirect {
  peer_subject: string;
}

table MessageSend {
  chat_id: string;
  client_id: string;
  text: string;
  forward_name: string;
