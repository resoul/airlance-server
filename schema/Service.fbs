namespace Airlance.Wire;

table Ping {
  ping_id: long;
}

table Pong {
  ping_id: long;
}

table Error {
  code: int;
  message: string;
}

table ProfileGet {
}

table ProfileSet {
  first_name: string;
  last_name: string;
  username: string;
  bio: string;
  phone: string;
  photo_media_id: string;
  video_media_id: string;
}

table ProfilePhoto {
  photo_media_id: string;
  video_media_id: string;
  added_at_unix: long;
}

table ProfilePhotoAdd {
  photo_media_id: string;
  video_media_id: string;
}

table ProfilePhotoRemove {
  photo_media_id: string;
}

table ProfileData {
  subject: string;
  first_name: string;
  last_name: string;
  username: string;
  bio: string;
  updated_at_unix: long;
  phone: string;
  photo_media_id: string;
  video_media_id: string;
  photos: [ProfilePhoto];
}

table Authenticate {
  access_token: string;
}

table Authenticated {
  expires_at_unix: long;
}

table UpdatesSubscribe {
  after_seq: ulong;
}

table UpdatesSubscribed {
  latest_seq: ulong;
}

table MediaUploadRequest {
  size: long;
}

table MediaUploadTicket {
  media_id: string;
  url: string;
