namespace Airlance.Wire;

table Ping {
  ping_id: long;
}

table Pong {
  ping_id: long;
}

table Error {
  code: int;
  message: string;
}

table ProfileGet {
}

table ProfileSet {
  first_name: string;
  last_name: string;
  username: string;
  bio: string;
  phone: string;
  photo_media_id: string;
  video_media_id: string;
}

table ProfilePhoto {
  photo_media_id: string;
  video_media_id: string;
  added_at_unix: long;
}

table ProfilePhotoAdd {
  photo_media_id: string;
  video_media_id: string;
}

table ProfilePhotoRemove {
  photo_media_id: string;
}

table ProfileData {
  subject: string;
  first_name: string;
  last_name: string;
  username: string;
  bio: string;
  updated_at_unix: long;
  phone: string;
  photo_media_id: string;
  video_media_id: string;
  photos: [ProfilePhoto];
}

table Authenticate {
  access_token: string;
}

table Authenticated {
  expires_at_unix: long;
}

table UpdatesSubscribe {
  after_seq: ulong;
}

table UpdatesSubscribed {
  latest_seq: ulong;
}

table MediaUploadRequest {
  size: long;
}

table MediaUploadTicket {
  media_id: string;
  url: string;
  expires_at_unix: long;
}

table MediaDownloadRequest {
  media_id: string;
}

table MediaDownloadTicket {
  url: string;
  expires_at_unix: long;
}

table Search {
  query: string;
}

table SearchPerson {
  subject: string;
  first_name: string;
  last_name: string;
  username: string;
  photo_media_id: string;
  video_media_id: string;
}

table SearchResults {
  people: [SearchPerson];
}

table PublicProfileGet {
  subject: string;
}

table MessageAttachment {
  kind: int;
  media_id: string;
  thumb_media_id: string;
  name: string;
  size: long;
  width: int;
  height: int;
  duration_ms: int;
  waveform: [ubyte];
  title: string;
  performer: string;
}

table MessageData {
  chat_id: string;
  message_id: long;
  sender: string;
  client_id: string;
  text: string;
  sent_at_unix_ms: long;
  sender_first_name: string;
  sender_last_name: string;
  sender_photo_media_id: string;
  sender_video_media_id: string;
  agent_name: string;
  forward_name: string;
  attachments: [MessageAttachment];
}

table ChatData {
  chat_id: string;
  peer_subject: string;
  peer_first_name: string;
  peer_last_name: string;
  peer_username: string;
  last_message: MessageData;
  peer_photo_media_id: string;
  peer_video_media_id: string;
  kind: int;
  title: string;
  about: string;
  link: string;
  invite_token: string;
  member_count: int;
  role: int;
  is_member: bool;
  is_pinned: bool;
  is_muted: bool;
}

table ChatOpenDirect {
  peer_subject: string;
}

table MessageSend {
  chat_id: string;
  client_id: string;
  text: string;
  forward_name: string;
  attachments: [MessageAttachment];
}

table HistoryGet {
  chat_id: string;
  before_id: long;
  limit: int;
}

table HistoryData {
  messages: [MessageData];
}

table ChatsGet {
  before_id: long;
}

table ChatsData {
